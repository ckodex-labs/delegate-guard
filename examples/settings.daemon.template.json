{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "__GUARD__ hook --socket __SOCKET__",
            "onFailure": "block"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "__GUARD__ hook --socket __SOCKET__"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "__GUARD__ hook --socket __SOCKET__"
          }
        ]
      }
    ]
  }
}
