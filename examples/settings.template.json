{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "__GUARD__ hook --policy __POLICY__ --state __STATE__",
            "onFailure": "block"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "__GUARD__ hook --policy __POLICY__ --state __STATE__"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "__GUARD__ hook --policy __POLICY__ --state __STATE__"
          }
        ]
      }
    ]
  }
}
